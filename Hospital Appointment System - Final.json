    {
      "parameters": {
        "functionCode": "// Process ALL items using loop\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const d = items[i].json;\n  const missing = [];\n  if (!d.name) missing.push('name');\n  if (!d.doctor) missing.push('doctor');\n  if (!d.date) missing.push('date');\n  if (!d.time) missing.push('time');\n  if (!d.phone) missing.push('phone');\n\n  if (missing.length > 0) {\n    results.push({ json: { status: 'error', text: 'Missing fields: ' + missing.join(', '), name: d.name || 'Unknown' } });\n  } else {\n    results.push({ json: { status: 'valid', name: d.name, doctor: d.doctor, date: d.date, time: d.time, phone: d.phone } });\n  }\n}\n\nreturn results;"
