      "parameters": {
        "functionCode": "// Process ALL items using loop\nconst store = this.getWorkflowStaticData('global');\n\nif (!store.bookings) {\n  store.bookings = [];\n}\n\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const data = items[i].json;\n\n  const exists = store.bookings.find(function(b) {\n    return b.doctor === data.doctor && b.date === data.date && b.time === data.time;\n  });\n\n  if (exists) {\n    results.push({\n      json: {\n        status: 'duplicate',\n        text: 'Slot Already Booked! Doctor: ' + data.doctor + ' | Date: ' + data.date + ' | Time: ' + data.time + ' | Originally booked by: ' + exists.name + ' | Requested by: ' + data.name\n      }\n    });\n  } else {\n    store.bookings.push(data);\n    results.push({\n      json: {\n        status: 'confirmed',\n        text: 'Appointment Confirmed! Name: ' + data.name + ' | Doctor: ' + data.doctor + ' | Date: ' + data.date + ' | Time: ' + data.time + ' | Phone: ' + data.phone\n      }\n    });\n  }\n}\n\nreturn results;"
      },
